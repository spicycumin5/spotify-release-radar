# Copy this file to `.env` (which is gitignored) and fill in real values.
# Astro CLI automatically loads `.env` into the scheduler/webserver containers.

# --- Spotify API ---
# Create an app at https://developer.spotify.com/dashboard
# Redirect URI must be: http://127.0.0.1:8888/callback
# (Spotify no longer allows "localhost" - use the literal loopback IP)
SPOTIFY_CLIENT_ID=your-spotify-client-id
SPOTIFY_CLIENT_SECRET=your-spotify-client-secret
# Obtained once via `python scripts/spotify_auth_setup.py`
SPOTIFY_REFRESH_TOKEN=your-spotify-refresh-token

# --- Alerting ---
# Where pipeline failure alerts are sent. Also the digest address for the
# single-user setup (SPOTIFY_REFRESH_TOKEN), registered as the first user.
ALERT_EMAIL_TO=you@example.com

# --- SMTP (Gmail example) ---
# Use a Gmail "App Password", not your normal password:
# https://myaccount.google.com/apppasswords
AIRFLOW__EMAIL__EMAIL_BACKEND=airflow.utils.email.send_email_smtp
AIRFLOW__SMTP__SMTP_HOST=smtp.gmail.com
AIRFLOW__SMTP__SMTP_PORT=587
AIRFLOW__SMTP__SMTP_STARTTLS=True
AIRFLOW__SMTP__SMTP_SSL=False
AIRFLOW__SMTP__SMTP_MAIL_FROM=your-gmail-address@gmail.com
AIRFLOW__SMTP__SMTP_USER=your-gmail-address@gmail.com
AIRFLOW__SMTP__SMTP_PASSWORD=your-gmail-app-password

# --- Postgres (defaults match Astro CLI's local Postgres) ---
PGHOST=localhost
PGPORT=5432
PGDATABASE=postgres
PGUSER=postgres
PGPASSWORD=postgres
# For a hosted database (e.g. Neon, used by the GitHub Actions schedule):
# PGSSLMODE=require

# --- Tuning (all optional; defaults shown) ---
# Max artists checked for new releases per run (2 requests each: albums and
# singles), and how soon one can be rechecked.
# SPOTIFY_ARTIST_BATCH_SIZE=20
# SPOTIFY_ARTIST_MIN_RECHECK_HOURS=20
# Request pacing, retries, and the longest 429 Retry-After waited out inline.
# SPOTIFY_MIN_REQUEST_INTERVAL=1.0
# SPOTIFY_MAX_RETRIES=4
# SPOTIFY_MAX_INLINE_RETRY_AFTER=10
# Users per mapped task, and how often to re-fetch follows / top artists.
# RADAR_USER_BATCH_SIZE=25
# RADAR_FOLLOWS_MAX_AGE_HOURS=20
# RADAR_AFFINITY_MAX_AGE_HOURS=72
# Releases dated more than this many days before the run date are never emailed.
# RADAR_MAX_RELEASE_AGE_DAYS=30
